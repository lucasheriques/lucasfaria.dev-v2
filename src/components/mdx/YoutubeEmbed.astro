---
interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;
---

<iframe
  class="video"
  src={`https://www.youtube-nocookie.com/embed/${videoId}`}
  title={title}
  loading="lazy"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  allowfullscreen
></iframe>
