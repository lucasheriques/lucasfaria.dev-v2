---
import type { InferGetStaticPropsType } from "astro";

import PostList from "../../components/PostList.astro";
import Page from "../../layouts/Page.astro";
import { getPosts, KINDS, kinds } from "../../lib/posts";

export const getStaticPaths = () =>
  kinds.map((kind) => ({ params: { kind }, props: { kind } }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { kind } = Astro.props;
const { title, description } = KINDS[kind];
const posts = await getPosts([kind]);
---

<Page title={title} description={description}>
  <p style="--i:2">{description}</p>
  <PostList posts={posts} style="--i:3" />
</Page>
